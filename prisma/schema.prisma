// ──────────────────────────────────────────────
// AUDIT & OBSERVABILITY
// ──────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String // e.g. "resume.optimized", "application.created"
  entityType String? // e.g. "Resume", "Application"
  entityId   String?  @db.Uuid
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  // Retention: 2 years — purge via cleanup worker

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model QueueEvent {
  id         String   @id @default(uuid()) @db.Uuid
  bullJobId  String
  queue      String
  jobType    String
  status     String // queued | active | completed | failed | stalled
  userId     String?  @db.Uuid
  durationMs Int?
  error      String?
  payload    Json?
  createdAt  DateTime @default(now())
  // Retention: 30 days — purge via cleanup worker

  @@index([bullJobId])
  @@index([queue, status, createdAt])
}

model ProviderEvent {
  id           String   @id @default(uuid()) @db.Uuid
  provider     String
  success      Boolean
  jobsFetched  Int      @default(0)
  jobsInserted Int      @default(0)
  jobsSkipped  Int      @default(0)
  durationMs   Int?
  error        String?
  createdAt    DateTime @default(now())
  // Retention: 90 days

  @@index([provider, createdAt])
  @@index([success, createdAt])
}

model ATSScoreHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  resumeId  String   @db.Uuid
  score     Int
  jobTitle  String?
  metadata  Json? // detailed breakdown snapshot
  createdAt DateTime @default(now())
  // Retention: unlimited (user data)

  @@index([resumeId, createdAt])
  @@index([userId, createdAt])
}

// ──────────────────────────────────────────────
// COMPLIANCE & GDPR
// ──────────────────────────────────────────────

model ConsentRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  consentType String // e.g. "marketing", "data_processing", "ai_training"
  granted     Boolean
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId, consentType])
}

model DataExportRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  status      String    @default("pending") // pending | processing | ready | delivered
  downloadUrl String?
  expiresAt   DateTime?
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, requestedAt])
}

model DeletionRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  reason      String?
  status      String    @default("pending") // pending | processing | completed
  requestedAt DateTime  @default(now())
  scheduledAt DateTime? // when deletion will execute (e.g. 30d cooling period)
  completedAt DateTime?

  @@index([userId])
  @@index([status, scheduledAt])
}

// ──────────────────────────────────────────────
// ANALYTICS MATERIALIZATION
// ──────────────────────────────────────────────

model AnalyticsSnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  date              DateTime @db.Date
  applicationsCount Int      @default(0)
  interviewsCount   Int      @default(0)
  offersCount       Int      @default(0)
  avgAtsScore       Float    @default(0)
  responseRate      Float    @default(0) // interviews / applications
  jobsIngested      Int      @default(0)
  metadata          Json? // arbitrary extra aggregation data
  createdAt         DateTime @default(now())
  // Retention: 1 year

  @@unique([userId, date])
  @@index([userId, date])
}

// ──────────────────────────────────────────────
// AI CAREER COACH
// ──────────────────────────────────────────────

model CoachSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String   @default("New conversation")
  messages  Json     @default("[]")
  mode      String   @default("chat")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes CoachNote[]

  @@index([userId, updatedAt])
}

model CoachNote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  sessionId String?  @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session CoachSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model CoachUsage {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  messagesUsedToday Int      @default(0)
  lastResetAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoachInsight {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  rejection Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// FEATURE FLAGS
// ──────────────────────────────────────────────

model FeatureFlag {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  rolloutPct  Int      @default(100) // 0–100 percentage rollout
  metadata    Json? // override config, A/B variants, etc.
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}

// ──────────────────────────────────────────────
// IDEMPOTENCY
// ──────────────────────────────────────────────

model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  userId    String   @db.Uuid
  operation String // e.g. "ats_optimize", "resume_upload"
  resultRef String? // ID of resulting resource, if applicable
  createdAt DateTime @default(now())
  expiresAt DateTime
  // Retention: 7 days — purge expired keys in cleanup worker

  @@index([key])
  @@index([userId, operation])
}

model WorkerHeartbeat {
  id         String   @id @default(uuid()) @db.Uuid
  workerId   String   @unique
  workerType String
  hostname   String
  lastSeenAt DateTime @default(now())
  metadata   Json?

  @@index([workerType, lastSeenAt])
}

model BrowserLease {
  id               String    @id @default(uuid()) @db.Uuid
  executionId      String    @db.Uuid
  browserSessionId String?   @db.Uuid
  contextId        String
  leasedAt         DateTime  @default(now())
  releasedAt       DateTime?
  status           String // "active", "released", "dead"

  execution BrowserExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  session   BrowserSession?  @relation(fields: [browserSessionId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@index([status])
}

model BrowserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  domain       String // e.g., "linkedin.com", "greenhouse.io"
  storageState String // Encrypted Playwright storageState
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leases BrowserLease[]

  @@unique([userId, domain])
  @@index([userId])
}

model BrowserExecution {
  id              String                 @id @default(uuid()) @db.Uuid
  workflowId      String                 @db.Uuid
  userId          String                 @db.Uuid
  status          BrowserExecutionStatus @default(queued)
  currentUrl      String? // Last known URL the browser is on
  currentTitle    String? // Last known page title
  contextId       String? // References internal Playwright context UUID if active
  metadata        Json? // Any launch parameters or debug info
  startedAt       DateTime?
  completedAt     DateTime?
  lastHeartbeatAt DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leases BrowserLease[]

  @@index([workflowId])
  @@index([userId])
  @@index([status, createdAt])
}

model ExecutionScreenshot {
  id          String   @id @default(uuid()) @db.Uuid
  executionId String   @db.Uuid
  workflowId  String   @db.Uuid
  url         String // The URL of the page at the time
  storageKey  String // Storage reference (e.g. Supabase storage or base64)
  createdAt   DateTime @default(now())

  @@index([executionId])
  @@index([workflowId, createdAt])
}

model DOMAction {
  id                 String   @id @default(uuid()) @db.Uuid
  executionId        String   @db.Uuid
  workflowId         String   @db.Uuid
  stepId             String?  @db.Uuid
  parentActionId     String?  @db.Uuid
  actionType         String // "click", "type", "navigate", "submit"
  selector           String?
  value              String? // the text typed or extracted
  url                String
  success            Boolean
  errorMessage       String?
  compressedSnapshot Bytes?
  timestamp          DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([executionId])
  @@index([workflowId, createdAt])
}

model ExecutionReasoning {
  id           String   @id @default(uuid()) @db.Uuid
  executionId  String   @db.Uuid
  workflowId   String   @db.Uuid
  decision     String // What the AI decided to do
  reasoning    String // Why it made that decision
  confidence   Float    @default(0.8) // 0.0 to 1.0
  alternatives Json? // Other options considered
  context      Json? // Page context at decision time
  createdAt    DateTime @default(now())

  @@index([executionId, createdAt])
  @@index([workflowId, createdAt])
}



model HiringContact {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  title        String?
  company      String
  linkedinUrl  String?   @unique
  email        String?
  isActive     Boolean   @default(true)
  hiringFor    String[]
  responseRate Float?
  lastActive   DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())

  jobOpportunities JobOpportunity[] @relation("ContactJobs")

  @@map("hiring_contacts")
}

model ConnectionPath {
  id               String @id @default(uuid()) @db.Uuid
  userId           String @db.Uuid
  jobOpportunityId String @db.Uuid

  type     String
  strength Float

  personName    String
  personTitle   String?
  personCompany String?

  sharedContext String?
  linkedinUrl   String?

  confidenceScore Float?
  confidenceTier  String? // verified | inferred | speculative
  source          String? // career_memory | resume | ai_inference | manual_import

  metadata  Json?
  createdAt DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobOpportunity JobOpportunity @relation(fields: [jobOpportunityId], references: [id], onDelete: Cascade)

  @@index([userId, jobOpportunityId])
  @@map("connection_paths")
}

// ──────────────────────────────────────────────
// POST-APPLICATION RELATIONSHIP ORCHESTRATION
// ──────────────────────────────────────────────

model EmailCampaign {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  applicationId    String?         @unique @db.Uuid
  jobOpportunityId String?         @db.Uuid
  recruiterEmail   String?
  recruiterName    String?
  jobTitle         String
  companyName      String
  status           String          @default("active") // active | paused | completed | replied
  stage            String          @default("follow_up") // follow_up | networking | referral_request
  lastReplyAt      DateTime?
  replyDetected    Boolean         @default(false)
  replyMetadata    Json?
  unsubscribeToken String?         @unique
  suppressedAt     DateTime?
  createdAt        DateTime        @default(now())
  
  emails           EmailDraft[]
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobOpportunity   JobOpportunity? @relation(fields: [jobOpportunityId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([jobOpportunityId])
}

model EmailDraft {
  id             String        @id @default(uuid()) @db.Uuid
  campaignId     String        @db.Uuid
  sequence       Int           // 1, 2, 3
  subject        String
  body           String        @db.Text
  explainability Json?         // "Why did the AI write this?"
  scheduledAt    DateTime
  sentAt         DateTime?
  status         String        @default("pending_approval") // pending_approval | scheduled | sent | skipped | replied
  metadata       Json?
  
  campaign       EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status, scheduledAt])
}

// ──────────────────────────────────────────────
// MARKET WEATHER REPORTING
// ──────────────────────────────────────────────

model MarketWeatherReport {
  id              String   @id @default(uuid()) @db.Uuid
  week            Int
  year            Int
  role            String
  industry        String
  location        String
  
  hiringTrend     String
  trendPct        Float
  hotSkills       String[]
  fastFillRoles   String[]
  avgDaysToFill   Float
  salaryTrend     String
  topHiringCompanies String[]
  
  headline        String
  detailedSummary String   @db.Text
  
  confidenceScore Float?
  signalStrength  String?
  signalMetadata  Json?
  
  generatedAt     DateTime @default(now())

  @@unique([week, year, role, industry, location])
  @@index([role, industry, generatedAt])
}

model SkillGapAnalysis {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  targetRole      String
  targetCompany   String?
  
  // Stored as JSON to support confidence levels ("strong", "working", "basic", "missing")
  // and marketDemandScore (1-10)
  currentSkills   Json[]   
  requiredSkills  Json[]
  gapSkills       Json[]
  
  learningPath    Json[]
  estimatedWeeks  Int
  progressPct     Float    @default(0)
  completedSkills String[] @default([])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, targetRole])
  @@index([userId])
}

model IndiaCompanyTrack {
  id                      String   @id @default(uuid()) @db.Uuid
  companyName             String   @unique
  companySlug             String   @unique
  tier                    String
  logoEmoji               String   @default("🏢")
  linkedinUrl             String?
  glassdoorUrl            String?
  hiringProcess           Json
  dsaRequired             Boolean  @default(true)
  dsaDifficulty           String   @default("medium")
  systemDesignRequired    Boolean  @default(true)
  machineRoundRequired    Boolean  @default(false)
  behavioralFormat        String   @default("STAR")
  knownQuestions          Json[]   @default([])
  salaryRanges            Json?
  avgTimelineDays         Int      @default(30)
  hiringStatus            String   @default("normal")
  interviewTips           String[]
  prepResources           Json[]   @default([])
  communityNotes          String?
  lastUpdated             DateTime @default(now())

  @@index([tier])
  @@index([hiringStatus])
}

model ResumeEqualizerSuggestion {
  id                  String   @id @default(uuid()) @db.Uuid
  resumeId            String   @db.Uuid
  userId              String   @db.Uuid
  collegeName         String
  collegeTier         String   // 'tier1' | 'tier2' | 'tier3'
  suggestedFormat     String
  summaryRewrite      String?  @db.Text
  skillsSectionBoost  String?  @db.Text
  educationDeEmphasis String?  @db.Text
  projectHighlights   Json[]
  rationale           String
  signalDensity       String?  @db.Text
  attentionGain       Int?
  appliedAt           DateTime?
  createdAt           DateTime @default(now())
  
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, resumeId])
}

model CareerPathSimulation {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  jobOpportunityId String?  @db.Uuid
  targetCompany    String
  targetRole       String
  currentRole      String
  goalIn5Years     String
  trajectoryPaths  Json[]
  careerAlignScore Float
  alignRationale   String
  riskFactors      String[]
  opportunities    String[]
  skillsGained     String[]
  skillsMissing    String[]
  verdict          String
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, targetCompany, targetRole])
}

model EmailCapture {
  id          String    @id @default(cuid())
  email       String    @unique
  source      String    // 'ats' | 'ctc-decoder' | 'salary-intelligence' | 'roles-page'
  metadata    Json?     // store what they were doing: role, score, etc
  convertedAt DateTime? // when they signed up for full account
  userId      String?   // linked once they create account
  createdAt   DateTime  @default(now())
}

model CareerIdentity {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  rolePercentile      Float    // e.g., 88.5 (Top 12%)
  cityPercentile      Float    // e.g., 90.0 (Top 10% in Bengaluru)
  activePrepStreak    Int      @default(0)
  lastActiveDay       DateTime?
  projectedLPAGrowth  Float    // Estimated 2-year growth in LPA
  weeklyDelta         Float    @default(0.0) // Change in momentum this week
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActionFeedItem {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  priority    Int      @default(0) // Higher = more urgent
  title       String
  description String
  actionUrl   String
  category    String   // "INTERVIEW_PREP", "SALARY_NEGOTIATION", "RESUME_GAP"
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, priority])
  @@index([userId, dismissed])
}

model VerifiedContribution {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  type            String   // "SALARY_SLIP", "OFFER_LETTER", "INTERVIEW_EXPERIENCE"
  company         String
  role            String
  totalLPA        Float
  baseSalary      Float
  variableSalary  Float
  esopsGrantLPA   Float?
  verifiedStatus  String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  creditsAwarded  Int      @default(0)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([company])
  @@index([role])
  @@index([verifiedStatus])
}

model ContributionCredit {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  available      Int      @default(0)
  lifetimeEarned Int      @default(0)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
