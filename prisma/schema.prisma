  fresherFriendliness Float   @default(0.5)
  referralDominance  Float    @default(0.5)
  collegeTierBias    Float    @default(0.5)
  hiringSeasonality  Json     @default("{}")
  intelligence       Json     @default("{}")
  trustScore         Float    @default(0.5)
  lastIngestedAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  roles              CompanyRole[]
  questionFrequencies QuestionFrequency[]
  experiences        InterviewExperience[]
