  longestStreak      Int      @default(0)
  verificationBadges String[] @default([])
  lastContributionAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([trustScore])
  @@index([totalPoints])
}

// 4-tier verification record for a contribution
model ContributionVerification {
  id             String   @id @default(uuid()) @db.Uuid
  contributionId String   @unique @db.Uuid
  tier           Int      @default(0) // 0 unverified | 1 email | 2 document | 3 peer
  method         String   @default("none")
