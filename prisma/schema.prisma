  salaryInsights     SalaryInsight[]
  selectionPatterns  SelectionPattern[]
  difficultyTrends   DifficultyTrend[]

  @@index([normalizedName])
  @@index([companyType, industry])
  @@index([tier])
}

model CompanyRole {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  title            String
  normalizedTitle  String
  level            String?
  family           String   @default("engineering")
