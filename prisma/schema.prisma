generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum ResumeStatus {
  completed
  pending
  processing
  failed
}

enum QueueJobType {
  autosave
  ats_analysis
  ai_rewrite
  export_pdf
  ai_job_intelligence
  ai_auto_apply
  ai_portfolio
  email_drip
  compute_analytics
  interview_ingest
  interview_normalize
  interview_embed
  interview_solution
  interview_moderate
}

enum QueueJobStatus {
  queued
  processing
  completed
  failed
}

enum ApplicationStatus {
  applied
  interview
  rejected
  offer
}

enum SubscriptionPlan {
  free
  pro
  enterprise
}

enum DataSourceType {
  verified
  estimated
  ai_inferred
}



enum BrowserExecutionStatus {
  queued
  booting
  navigating
  authenticating
  waiting_for_selector
  filling_form
  waiting_for_approval
  captcha_required
  uploading_resume
  submitting
  completed
  failed
  canceled
  timed_out
}

enum TwinAutonomyMode {
  manual
  assisted
  autonomous
}

enum TwinStatus {
  onboarding
  learning
  active
  paused
  archived
}

enum TwinMemoryType {
  resume
  project
  interview_answer
  recruiter_conversation
  application
  salary_negotiation
  skill
  feedback
  strength
  weakness
  learning_goal
  rejection_pattern
  emotional_state
  work_preference
  company_preference
  behavior_signal
  market_signal
}

enum TwinInsightCategory {
  identity
  behavior
  communication
  market
  interview
  negotiation
  wellbeing
  learning
  recruiter
  india_market
  safety
}

enum PredictionType {
  callback_probability
  interview_probability
  offer_probability
  salary_probability
  recruiter_response_probability
  ghosting_risk
  scam_risk
  burnout_risk
  skill_stagnation_risk
  career_ceiling_risk
}

enum TwinEventType {
  created
  evolved
  memory_added
  insight_created
  prediction_created
  simulation_created
  approval_requested
  action_executed
  privacy_changed
  export_requested
  delete_requested
}

enum InterviewQuestionKind {
  dsa
  system_design
  lld
  hld
  oop
  dbms
  sql
  os
  networking
  devops
  ml_ai
  cloud
  security
  behavioral
  oa_coding
  oa_mcq
  puzzle
  aptitude
}

enum InterviewDifficulty {
  easy
  medium
  hard
  expert
  unknown
}

enum InterviewSourceType {
  leetcode
  geeksforgeeks
  reddit
  glassdoor
  blind
  github
  hackerrank
  interviewbit
  user_submission
  company_seed
  ai_inferred
}

enum InterviewModerationStatus {
  pending
  approved
  rejected
  needs_review
  quarantined
}

enum InterviewRoundType {
  recruiter_screen
  online_assessment
  technical
  dsa
  machine_coding
  system_design
  lld
  hld
  behavioral
  hiring_manager
  hr
  aptitude
  case_study
}

enum InterviewIngestionStatus {
  queued
  crawling
  normalizing
  enriching
  indexed
  failed
  skipped
}

enum InterviewContributionType {
  question
  experience
  recruiter_pattern
  salary
  correction
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  name           String?
  email          String           @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  activeResumeId String?          @db.Uuid
  plan           SubscriptionPlan @default(free)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  accounts             Account[]
  sessions             Session[]
  resumes              Resume[]
  resumeVersions       ResumeVersion[]
  jobs                 Job[]
  jobOpportunities     JobOpportunity[]
  connectionPaths      ConnectionPath[]
  applications         Application[]
  interviewSessions    InterviewSession[]
  aiUsages             AIUsage[]
  careerProfile        CareerProfile?
  browserSessions      BrowserSession[]
  browserExecutions    BrowserExecution[]
  careerMemories       CareerMemory[]
  applicationArtifacts ApplicationArtifact[]
  emailCampaigns       EmailCampaign[]
  negotiationSessions  NegotiationSession[]
  ctcDecodings         CtcDecoding[]
  applicationAnalytics ApplicationAnalytics?
  wellbeingCheckIns    WellbeingCheckIn[]
  searchMilestones     SearchMilestone[]
  offerComparisons     OfferComparison[]
  coachSessions        CoachSession[]
  coachNotes           CoachNote[]
  coachUsage           CoachUsage?
  coachInsight         CoachInsight?
  skillGaps            SkillGapAnalysis[]
  equalizerSuggestions ResumeEqualizerSuggestion[]
  careerSimulations    CareerPathSimulation[]
  careerTwin           CareerTwin?
  twinMemories         TwinMemory[]
  twinInsights         TwinInsight[]
  careerTrajectories   CareerTrajectory[]
  outcomePredictions   OutcomePrediction[]
  recruiterInteractions RecruiterInteraction[]
  twinSkillGaps        SkillGap[]
  twinSimulations      CareerSimulation[]
  twinEvents           TwinEvent[]
  submittedInterviewExperiences InterviewExperience[]
  interviewContributions InterviewContribution[]
  interviewMockSessions InterviewMockSession[]
  interviewSearchEvents InterviewSearchEvent[]
  contributorReputation ContributorReputation?
  contributionVotes     ContributionVote[]
  careerIdentity        CareerIdentity?
  actionFeedItems       ActionFeedItem[]
  verifiedContributions VerifiedContribution[]
  contributionCredit    ContributionCredit?

  @@index([email])
}

model CareerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  headline          String?
  summary           String?
  goals             Json?
  preferences       Json?
  constraints       Json?
  salaryExpectation Json?
  autonomyPolicy    Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// AI CAREER TWIN
// ---------------------------------------------------------------------------

model CareerTwin {
  id                  String           @id @default(uuid()) @db.Uuid
  userId              String           @unique @db.Uuid
  displayName         String           @default("AI Career Twin")
  status              TwinStatus       @default(onboarding)
  autonomyMode        TwinAutonomyMode @default(manual)
  professionalIdentity Json            @default("{}")
  cognitiveProfile    Json             @default("{}")
  scores              Json             @default("{}")
  confidence          Float            @default(0.45)
  strengths           String[]         @default([])
  weaknesses          String[]         @default([])
  bestFitRoles        Json             @default("[]")
  hiddenOpportunities Json             @default("[]")
  salaryProjection    Json             @default("{}")
  activePlan          Json             @default("{}")
  privacyControls     Json             @default("{}")
  lastEvolvedAt       DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories             TwinMemory[]
  insights             TwinInsight[]
  trajectories         CareerTrajectory[]
  predictions          OutcomePrediction[]
  recruiterInteractions RecruiterInteraction[]
  skillGaps            SkillGap[]
  simulations          CareerSimulation[]
  events               TwinEvent[]

  @@index([userId, status])
  @@index([lastEvolvedAt])
}

model TwinMemory {
  id                 String         @id @default(uuid()) @db.Uuid
  twinId             String         @db.Uuid
  userId             String         @db.Uuid
  type               TwinMemoryType
  title              String
  content            String         @db.Text
  summary            String?        @db.Text
  source             String         @default("agent")
  evidenceRefs       String[]       @default([])
  semanticLinks      Json           @default("[]")
  importance         Float          @default(0.5)
  confidence         Float          @default(0.7)
  recencyWeight      Float          @default(1)
  reinforcementCount Int            @default(0)
  accessScope        String         @default("private")
  metadata           Json           @default("{}")
  decayAt            DateTime?
  expiresAt          DateTime?
  /// pgvector 1536-dim embedding. Written/read through raw SQL.
  embedding          Unsupported("vector(1536)")?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  twin CareerTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([twinId, importance])
  @@index([decayAt])
}

model TwinInsight {
  id          String              @id @default(uuid()) @db.Uuid
  twinId      String              @db.Uuid
  userId      String              @db.Uuid
  category    TwinInsightCategory
  title       String
  insight     String              @db.Text
  evidence    Json                @default("[]")
  actions     Json                @default("[]")
  confidence  Float               @default(0.65)
  impactScore Float               @default(0.5)
  status      String              @default("active")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  twin CareerTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category, createdAt])
  @@index([twinId, status, impactScore])
}



model CareerTrajectory {
  id               String   @id @default(uuid()) @db.Uuid
  twinId           String   @db.Uuid
  userId           String   @db.Uuid
  currentRole      String?
  targetRole       String?
  seniority        String?
  industry         String?
  trajectory       Json     @default("[]")
  salaryTrajectory Json     @default("[]")
  risks            Json     @default("[]")
  opportunities    Json     @default("[]")
  confidence       Float    @default(0.55)
  validFrom        DateTime @default(now())
  validTo          DateTime?
  createdAt        DateTime @default(now())

  twin CareerTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([twinId, validFrom])
}

model OutcomePrediction {
  id             String         @id @default(uuid()) @db.Uuid
  twinId         String         @db.Uuid
  userId         String         @db.Uuid
  predictionType PredictionType
  subjectType    String
  subjectId      String?
  score          Float
  confidence     Float          @default(0.6)
  explanation    String         @db.Text
  evidence       Json           @default("[]")
  actions        Json           @default("[]")
  modelVersion   String         @default("heuristic-v1")
  expiresAt      DateTime?
  createdAt      DateTime       @default(now())

  twin CareerTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, predictionType, createdAt])
  @@index([subjectType, subjectId])
}



model RecruiterInteraction {
  id              String   @id @default(uuid()) @db.Uuid
  twinId          String   @db.Uuid
  userId          String   @db.Uuid
  recruiterName   String?
  company         String
  channel         String   @default("unknown")
  role            String?
  responseLatency Int?
  sentiment       String   @default("unknown")
  responseQuality Float    @default(0.5)
  ghostingRisk    Float    @default(0.3)
  trustScore      Float    @default(0.5)
  compensationSignals Json  @default("{}")
  notes           String?  @db.Text
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  twin CareerTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, company, occurredAt])
  @@index([trustScore])
}

model SkillGap {
  id              String   @id @default(uuid()) @db.Uuid
  twinId          String   @db.Uuid
  userId          String   @db.Uuid
  targetRole      String
  skill           String
  currentLevel    Float    @default(0.2)
  requiredLevel   Float    @default(0.8)
  marketDemand    Float    @default(0.5)
  priority        Float    @default(0.5)
  learningPlan    Json     @default("[]")
  status          String   @default("open")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  twin CareerTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetRole, skill])
  @@index([twinId, status, priority])
}

model CareerSimulation {
  id                  String   @id @default(uuid()) @db.Uuid
  twinId              String   @db.Uuid
  userId              String   @db.Uuid
  question            String   @db.Text
  scenario            Json     @default("{}")
  baseline            Json     @default("{}")
  projection          Json     @default("{}")
  confidenceIntervals Json     @default("{}")
  uncertainty         Json     @default("[]")
  recommendation      String   @db.Text
  confidence          Float    @default(0.55)
  createdAt           DateTime @default(now())

  twin CareerTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TwinEvent {
  id          String        @id @default(uuid()) @db.Uuid
  twinId      String        @db.Uuid
  userId      String        @db.Uuid
  type        TwinEventType
  source      String        @default("system")
  summary     String
  payload     Json          @default("{}")
  traceId     String        @default(uuid())
  createdAt   DateTime      @default(now())

  twin CareerTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([twinId, type, createdAt])
  @@index([traceId])
}

model CareerMemory {
  id          String                       @id @default(uuid()) @db.Uuid
  userId      String                       @db.Uuid
  type        String
  title       String
  content     String
  evidenceRef String?
  confidence  Float                        @default(0.7)
  source      String                       @default("user")
  visibility  String                       @default("private")
  metadata    Json?
  expiresAt   DateTime?
  /// pgvector 1536-dim embedding (text-embedding-3-small).
  /// Managed via raw SQL — Prisma Client cannot set/read this column directly.
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, createdAt])
}



model ApplicationArtifact {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  applicationId String?  @db.Uuid
  resumeId      String?  @db.Uuid
  type          String
  title         String
  content       Json
  source        String   @default("agent")
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  resume      Resume?      @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId, type, createdAt])
  @@index([applicationId])
  @@index([resumeId, createdAt])
}

model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Resume {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  title     String       @default("Untitled Resume")
  data      Json
  status    ResumeStatus @default(completed)
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions             ResumeVersion[]
  jobs                 Job[]
  applications         Application[]
  applicationArtifacts ApplicationArtifact[]
  equalizerSuggestions ResumeEqualizerSuggestion[]

  @@index([userId, updatedAt])
  @@index([userId, id])
}

model ResumeVersion {
  id        String   @id @default(uuid()) @db.Uuid
  resumeId  String   @db.Uuid
  userId    String   @db.Uuid
  version   Int
  title     String
  data      Json
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resumeId, version])
  @@index([resumeId, createdAt])
  @@index([userId, createdAt])
}

model Job {
  id          String         @id @default(uuid()) @db.Uuid
  bullJobId   String?        @unique
  type        QueueJobType
  status      QueueJobStatus @default(queued)
  userId      String         @db.Uuid
  resumeId    String?        @db.Uuid
  payload     Json
  attempts    Int            @default(0)
  lastError   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resumeId, createdAt])
  @@index([type, status])
}

model CanonicalJob {
  id                 String   @id @default(uuid()) @db.Uuid
  canonicalHash      String   @unique

  normalizedTitle    String
  normalizedCompany  String
  normalizedLocation String?

  primarySource      String
  sourceCount        Int      @default(1)

  confidenceScore    Float?
  mergeConfidence    Float?
  mergeStrategy      String?
  mergeMetadata      Json?
  
  // freshness intelligence
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  providerJobs       JobOpportunity[]

  @@index([normalizedCompany])
  @@index([canonicalHash])
}

model JobOpportunity {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  canonicalJobId String?        @db.Uuid
  company        String
  role           String
  location       String?
  salaryRange    String?
  description    String
  matchScore     Int            @default(0)
  parsed         Json?
  sourceUrl      String?
  sourceType     DataSourceType @default(verified)
  ghostScore     Float          @default(0)
  ghostSignals   Json?
  scamScore      Float?
  scamVerdict    String         @default("unknown")
  scamSignals    Json?
  scamReports    Int            @default(0)
  lastVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalJob    CanonicalJob?    @relation(fields: [canonicalJobId], references: [id], onDelete: SetNull)
  applications    Application[]
  hiringContacts  HiringContact[]  @relation("ContactJobs")
  connectionPaths ConnectionPath[]
  emailCampaigns  EmailCampaign[]

  @@index([userId, matchScore])
  @@index([userId, createdAt])
  @@map("job_opportunities")
}

model AIUsage {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  estimatedCost    Float
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Application {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  resumeId         String?           @db.Uuid
  jobOpportunityId String?           @db.Uuid
  company          String
  role             String
  status           ApplicationStatus @default(applied)
  matchScore       Int               @default(0)
  generatedResume  String?
  coverLetter      String?
  emailDraft       String?
  notes            String?
  appliedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?               @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobOpportunity JobOpportunity?       @relation(fields: [jobOpportunityId], references: [id], onDelete: SetNull)
  artifacts      ApplicationArtifact[]
  emailCampaign  EmailCampaign?

  @@index([userId, status])
  @@index([resumeId, createdAt])
  @@index([jobOpportunityId])
}

model NegotiationSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  jobTitle       String
  companyName    String
  offerBase      Float
  offerEquity    String?
  offerBonus     Float?
  offerBenefits  Json?
  location       String?
  currency       String   @default("INR")
  marketMin      Float?
  marketMax      Float?
  marketMedian   Float?
  counterScript  Json?
  negotiationLog Json[]   @default([])
  finalOffer     Float?
  outcome        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CtcDecoding {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  rawInput          String?  @db.Text
  company           String?
  quotedCtc         Float
  fixedComponent    Float
  variableComponent Float    @default(0)
  variablePct       Float    @default(0)
  basicSalary       Float
  hra               Float    @default(0)
  specialAllowance  Float    @default(0)
  pfEmployee        Float
  pfEmployer        Float
  gratuityAnnual    Float
  bonus             Float    @default(0)
  esop              Float    @default(0)
  otherAllowances   Json     @default("[]")
  grossMonthly      Float
  netMonthly        Float
  taxAnnual         Float
  taxRegime         String   @default("new")
  effectiveCtc      Float
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CompanyIntelligence {
  id               String   @id @default(uuid()) @db.Uuid
  companyName      String
  companyDomain    String?
  healthScore      Float
  hiringVelocity   String
  fundingStage     String?
  employeeCount    String?
  glassdoorRating  Float?
  recentNews       Json[]   @default([])
  interviewProcess Json?
  cultureSignals   Json?
  layoffRisk       String
  scamRisk         String   @default("unknown")
  scamSignals      Json?
  lastRefreshedAt  DateTime @default(now())
  createdAt        DateTime @default(now())

  @@unique([companyName])
  @@index([companyName])
  @@index([healthScore])
}

model ApplicationAnalytics {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  totalApplied      Int      @default(0)
  totalResponses    Int      @default(0)
  totalInterviews   Int      @default(0)
  totalOffers       Int      @default(0)
  responseRate      Float    @default(0)
  interviewRate     Float    @default(0)
  offerRate         Float    @default(0)
  avgDaysToResponse Float?
  bestDayOfWeek     String?
  bestPlatform      String?
  weakestSection    String?
  lastComputedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AnonymousBenchmark {
  id             String   @id @default(uuid()) @db.Uuid
  roleLevel      String
  industry       String
  location       String
  responseRate   Float
  interviewRate  Float
  offerRate      Float
  avgDaysToOffer Float
  sampleSize     Int
  updatedAt      DateTime @updatedAt

  @@unique([roleLevel, industry, location])
}

model CompanyInterviewBrief {
  id                String   @id @default(uuid()) @db.Uuid
  companyName       String   @unique
  rounds            Int?
  roundDescriptions Json[]   @default([])
