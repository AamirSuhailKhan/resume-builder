  questionFrequencies QuestionFrequency[]
  experiences        InterviewExperience[]
  selectionPatterns  SelectionPattern[]
  difficultyTrends   DifficultyTrend[]

  @@unique([companyId, normalizedTitle, level, location])
  @@index([normalizedTitle, level])
  @@index([companyId, family])
}

model InterviewQuestion {
  id              String                    @id @default(uuid()) @db.Uuid
  canonicalHash   String                    @unique
  title           String
  prompt          String                    @db.Text
  normalizedPrompt String                   @db.Text
  kind            InterviewQuestionKind
  difficulty      InterviewDifficulty       @default(unknown)
  topic           String?
  subtopic        String?
  constraints     Json                      @default("{}")
  examples        Json                      @default("[]")
  sourceType      InterviewSourceType
  sourceUrl       String?
  sourceTitle     String?
  sourceAttribution Json                    @default("{}")
  moderationStatus InterviewModerationStatus @default(pending)
  qualityScore    Float                     @default(0.5)
  originalityScore Float                    @default(0.5)
  popularityScore Float                     @default(0)
  freshnessScore  Float                     @default(1)
  lastSeenAt      DateTime                  @default(now())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  solution         QuestionSolution?
  embedding        QuestionEmbedding?
  cluster          QuestionCluster?         @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  clusterId        String?                  @db.Uuid
  frequencies      QuestionFrequency[]
  tags             QuestionTag[]
  behavioral       BehavioralQuestion?
  systemDesign     SystemDesignQuestion?
  rounds           InterviewRound[]
  contributions    InterviewContribution[]

  @@index([kind, difficulty])
  @@index([moderationStatus, qualityScore])
  @@index([popularityScore, freshnessScore])
  @@index([lastSeenAt])
}

model QuestionSolution {
  id                     String   @id @default(uuid()) @db.Uuid
  questionId             String   @unique @db.Uuid
  bruteForce             Json     @default("{}")
  optimized              Json     @default("{}")
  explanations           Json     @default("{}")
  dryRun                 Json     @default("[]")
  edgeCases              String[] @default([])
  interviewerExpectations String[] @default([])
  followUps              String[] @default([])
  languages              Json     @default("{}")
  timeComplexity         String?
  spaceComplexity        String?
  generatedBy            String   @default("gemini")
  originalityDisclaimer  String   @default("Generated original explanation; not copied from source material.")
  confidence             Float    @default(0.62)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model InterviewExperience {
  id               String                    @id @default(uuid()) @db.Uuid
  userId           String?                   @db.Uuid
  companyId        String                    @db.Uuid
  companyRoleId    String?                   @db.Uuid
  title            String
  roleTitle        String?
  level            String?
  location         String?
  outcome          String                    @default("unknown")
  verdict          String?
  overallDifficulty InterviewDifficulty      @default(unknown)
  roundsCount      Int?
  timelineDays     Int?
  rawText          String                    @db.Text
  summary          String                    @db.Text
  sourceType       InterviewSourceType
  sourceUrl        String?
  sourceAttribution Json                     @default("{}")
  moderationStatus InterviewModerationStatus @default(pending)
  trustScore       Float                     @default(0.5)
  recencyScore     Float                     @default(1)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
