  rounds           InterviewRound[]
  contributions    InterviewContribution[]

  @@index([companyId, createdAt])
  @@index([companyRoleId, createdAt])
  @@index([moderationStatus, trustScore])
  @@index([sourceType, occurredAt])
}

model InterviewRound {
  id             String             @id @default(uuid()) @db.Uuid
