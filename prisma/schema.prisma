  upvoteCount      Int                       @default(0)
  downvoteCount    Int                       @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     InterviewQuestion?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  experience   InterviewExperience?    @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  verification ContributionVerification?
