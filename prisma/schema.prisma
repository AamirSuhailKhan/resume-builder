  salaryTrend      String?  // "compressing" | "inflating" | "stable"
  
  // Loop Characteristics
  roundDistribution Json    // { machine_coding: 0.2, sys_design: 0.4, dsa: 0.4 }
  
  updatedAt        DateTime @updatedAt
  
  @@unique([companyId, normalizedRole])
}

