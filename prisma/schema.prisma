generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ResumeStatus {
  completed
  pending
  processing
  failed
}

enum QueueJobType {
  autosave
  ats_analysis
  ai_rewrite
  export_pdf
  ai_job_intelligence
  ai_auto_apply
  ai_portfolio
}

enum QueueJobStatus {
  queued
  processing
  completed
  failed
}

enum ApplicationStatus {
  applied
  interview
  rejected
  offer
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  activeResumeId String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  resumes           Resume[]
  resumeVersions    ResumeVersion[]
  jobs              Job[]
  jobOpportunities  JobOpportunity[]
  applications      Application[]
  interviewSessions InterviewSession[]

  @@index([email])
}

model Account {
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Resume {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  title     String       @default("Untitled Resume")
  data      Json
  status    ResumeStatus @default(completed)
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]
  jobs         Job[]
  applications Application[]

  @@index([userId, updatedAt])
  @@index([userId, id])
}

model ResumeVersion {
  id        String   @id @default(uuid()) @db.Uuid
  resumeId  String   @db.Uuid
  userId    String   @db.Uuid
  version   Int
  title     String
  data      Json
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resumeId, version])
  @@index([resumeId, createdAt])
  @@index([userId, createdAt])
}

model Job {
  id          String         @id @default(uuid()) @db.Uuid
  bullJobId   String?        @unique
  type        QueueJobType
  status      QueueJobStatus @default(queued)
  userId      String         @db.Uuid
  resumeId    String?        @db.Uuid
  payload     Json
  attempts    Int            @default(0)
  lastError   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([resumeId, createdAt])
  @@index([type, status])
}

model JobOpportunity {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  company     String
  role        String
  location    String?
  salaryRange String?
  description String
  matchScore  Int      @default(0)
  parsed      Json?
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId, matchScore])
  @@index([userId, createdAt])
  @@map("job_opportunities")
}

model Application {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  resumeId         String?           @db.Uuid
  jobOpportunityId String?           @db.Uuid
  company          String
  role             String
  status           ApplicationStatus @default(applied)
  matchScore       Int               @default(0)
  generatedResume  String?
  coverLetter      String?
  emailDraft       String?
  notes            String?
  appliedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobOpportunity JobOpportunity? @relation(fields: [jobOpportunityId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([resumeId, createdAt])
  @@index([jobOpportunityId])
}

model InterviewSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  company   String?
  role      String?
  questions Json
  answers   Json
  feedback  Json?
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
