model ContributionVote {
  id             String   @id @default(uuid()) @db.Uuid
  contributionId String   @db.Uuid
  userId         String   @db.Uuid
  type           String   // "helpful" | "not_helpful" | "inaccurate"
  createdAt      DateTime @default(now())

  contribution InterviewContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contributionId, userId])
  @@index([contributionId, type])
  @@index([userId])
}

model InterviewModerationEvent {
  id             String   @id @default(uuid()) @db.Uuid
  contributionId String?  @db.Uuid
  entityType     String
  entityId       String?
  decision       InterviewModerationStatus
  reasons        String[] @default([])
  modelSignals   Json     @default("{}")
  reviewerId     String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@index([decision, createdAt])
  @@index([entityType, entityId])
}

// Contradiction detection alerts
model ContradictionAlert {
  id             String   @id @default(uuid()) @db.Uuid
  entityType     String   // "Company" | "Question" | "Salary"
  entityId       String
  type           String   // "pattern_drift" | "difficulty_flip" | "salary_anomaly" | "round_count_drift" | "sudden_spike"
  severity       String   // "soft" | "hard"
  score          Float    @default(0)
  details        String   @db.Text
  shouldEscalate Boolean  @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([entityType, entityId, type])
  @@index([severity, shouldEscalate])
  @@index([resolvedAt])
  @@index([createdAt])
}

// Moderation work queue item
model ModerationQueueItem {
  id           String   @id @default(uuid()) @db.Uuid
  priority     Int      @default(3)   // 0=P0 immediate, 1=P1, 2=P2, 3=P3 batch
  queueType    String   // "fraud" | "contradiction" | "low_quality" | "verification" | "duplicate"
  entityType   String   // "InterviewContribution" | "ContradictionAlert" etc.
  entityId     String
  summary      String
  fraudScore   Float?
  reviewerId   String?  @db.Uuid
  status       String   @default("pending") // "pending" | "in_review" | "resolved" | "dismissed"
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resolvedAt   DateTime?

  @@index([priority, status, createdAt])
  @@index([queueType, status])
  @@index([reviewerId])
}

// Represents a synthesized intelligence snapshot
model CompanyIntelligenceSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @db.Uuid
  companyName      String
  periodStart      DateTime
  periodEnd        DateTime
  
  // Synthesized Metrics
  hiringVelocity   String   // "freeze" | "slow" | "normal" | "high"
  avgDifficulty    Float
  sysDesignWeight  Float
  dsaWeight        Float
  avgTimelineDays  Float
  ghostingRate     Float

  // Confidence & Traceability
  confidenceScore  Float
  confidenceInterval Json?    // e.g., [82, 91]
  trendStability   String?  // "high" | "medium" | "volatile"
  dataPointsCount  Int
  
  // Trend Deltas (vs previous snapshot)
  signals          Json     // Array of P0/P1 insights
  trace            Json?    // Detailed explanation trace
  
  createdAt        DateTime @default(now())

  @@index([companyId, periodEnd])
}

// Role-specific timeline node
